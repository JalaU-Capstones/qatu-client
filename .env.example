# ── Client build-time configuration (Vite) ──
# VITE_API_BASE_URL is baked at build time by Vite (import.meta.env).
# The value MUST be reachable from the user's BROWSER, not from the container.
#
#   Mode A — Dev, Vite on host, API container on host:3000:
#     VITE_API_BASE_URL=http://localhost:3000/v1
#
#   Mode B — Dev, Vite containerized + API containerized, same qatu-net:
#     VITE_API_BASE_URL=http://localhost:3000/v1
#
#   Mode C — Prod, nginx serves the SPA and reverse-proxies /v1 to api:3000:
#     VITE_API_BASE_URL=/v1
VITE_API_BASE_URL=http://localhost:3000/v1

# ── Docker Compose (see docker-compose.{dev,prod}.yml) ──
# Host port for the client dev server (docker-compose.dev.yml).
CLIENT_DEV_PORT=5173

# Host port for the client prod nginx (docker-compose.prod.yml).
# Default: 8080 (safe, no privilege required).
# Production recommendation: 80 (requires Docker daemon with port-bind capability).
CLIENT_PORT=8080

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
