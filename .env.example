# ── Client build-time configuration (Vite) ──
# VITE_API_BASE_URL is baked at build time by Vite (import.meta.env).
# The value MUST be reachable from the user's BROWSER, not from the container.
#
#   Mode A — Dev, Vite on host, API container on host:3000:
#     VITE_API_BASE_URL=http://localhost:3000/v1
#
#   Mode B — Dev, Vite containerized + API containerized, same qatu-net:
#     VITE_API_BASE_URL=http://localhost:3000/v1
#
#   Mode C — Prod, nginx serves the SPA and reverse-proxies /v1 to api:3000:
#     VITE_API_BASE_URL=/v1
VITE_API_BASE_URL=http://localhost:3000/v1

# ── Docker Compose (see docker-compose.{dev,prod}.yml) ──
# Host port for the client dev server (docker-compose.dev.yml).
CLIENT_DEV_PORT=5173

# Host port for the client prod nginx (docker-compose.prod.yml).
# Default: 8080 (safe, no privilege required).
# Production recommendation: 80 (requires Docker daemon with port-bind capability).
CLIENT_PORT=8080

# ── Supabase (Vite build-time vars, baked into the SPA bundle) ──
#
# These are PUBLIC values — the anon key is designed to ship in every
# Supabase frontend bundle. They are only used by the frontend for the
# OAuth PKCE flow (AuthCallbackView). All authenticated API calls go
# through the backend (HttpOnly cookies, ADR-012) — the anon key is
# never used to call the API from the browser.
#
# For local dev with Supabase CLI (`npx supabase start`), get the values:
#     npx supabase status -o env | grep -E 'API_URL|ANON_KEY'
# and set:
#     VITE_SUPABASE_URL=http://localhost:54321
#     VITE_SUPABASE_ANON_KEY=<ANON_KEY from supabase status>
#
# For production (Supabase Cloud), use the project's URL and anon key.
#
# REQUIRED for both `pnpm dev` (reads .env directly) AND Docker builds
# (passed as --build-arg by docker-compose.{dev,prod}.yml → Dockerfile).
# If unset in a prod build, the SPA crashes with `supabaseKey is required`.
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=your-anon-key-from-supabase-status
